# Tool and image pins, in ONE place. Sourced by the scripts and by CI.
KIND_VERSION=v0.33.0
KIND_CLUSTER=secure-notes
NAMESPACE=secure-notes

# Built by `docker compose build` (docker-compose.yml) and used unchanged by
# Docker Compose and kind, then published to GHCR.
APP_IMAGE=secure-notes-app:dev
MOCK_IMAGE=secure-notes-aws-mock:dev

# Third-party images both stacks run; preloaded into kind so no pod waits on Docker Hub.
POSTGRES_IMAGE=docker.io/library/postgres:16
REDIS_IMAGE=docker.io/library/redis:7-alpine

# The browser walk that photographs the dashboard (same pin as cilium-implementation-poc).
PLAYWRIGHT_VERSION=1.63.0
JS_YAML_VERSION=4.1.0

# Supply chain (scripts/scan-images.sh): SBOM with syft, vulnerability scan with
# grype. Release tarballs are checked against the release's checksums file.
SYFT_VERSION=v1.52.0
GRYPE_VERSION=v0.119.0
# cosign signs the published images (.github/workflows/ci.yaml, images job).
COSIGN_VERSION=v3.1.3

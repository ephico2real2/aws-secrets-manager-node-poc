# Point the docker CLI and kind at Podman, in this shell. Source it (bash or zsh):
#
#   . scripts/podman.env
#
# The lab's scripts call `docker`; the docker CLI reaches Podman through its API socket.
#   macOS: the Podman machine's socket (start the machine first: podman machine start).
#   Linux: rootless Podman's user socket (systemctl --user enable --now podman.socket).
# Sets DOCKER_HOST and KIND_EXPERIMENTAL_PROVIDER=podman; changes nothing else.
# shellcheck shell=bash

if [ "$(uname -s)" = Darwin ]; then
  _podman_sock=$(podman machine inspect --format '{{.ConnectionInfo.PodmanSocket.Path}}' 2>/dev/null | head -1)
else
  _podman_sock=$(podman info --format '{{.Host.RemoteSocket.Path}}' 2>/dev/null)
fi
if [ -n "$_podman_sock" ] && [ -S "$_podman_sock" ]; then
  export DOCKER_HOST="unix://$_podman_sock"
  export KIND_EXPERIMENTAL_PROVIDER=podman
  echo "podman.env: DOCKER_HOST=$DOCKER_HOST, KIND_EXPERIMENTAL_PROVIDER=podman"
else
  echo "podman.env: no Podman socket found (macOS: podman machine start; Linux: systemctl --user enable --now podman.socket)" >&2
fi
unset _podman_sock
